# Copy these into Render > Environment. Never commit real values to GitHub.

# ---- Required ----
VERIFY_TOKEN=make_up_a_long_random_string
APP_SECRET=from_Meta_app_settings_basic
GEMINI_API_KEY=your_gemini_key
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=supabase_service_role_key
ADMIN_PASSWORD=a_long_password_for_the_staff_pages

# ---- WhatsApp ----
WHATSAPP_TOKEN=system_user_permanent_token
PHONE_NUMBER_ID=whatsapp_phone_number_id
STAFF_WHATSAPP_NUMBER=2348034043725

# ---- Messenger ----
PAGE_ACCESS_TOKEN=page_access_token

# ---- Instagram ----
IG_ACCESS_TOKEN=instagram_access_token
IG_ACCOUNT_ID=instagram_account_id
# Only if Instagram uses a different app secret from APP_SECRET
IG_APP_SECRET=

# ---- Optional ----
BASE_URL=https://your-service.onrender.com
ADMIN_USER=admin
ASSISTANT_NAME=Triple H Assistant
GEMINI_MODEL=gemini-3.5-flash-lite
HUMAN_PAUSE_HOURS=2
SESSION_TIMEOUT_HOURS=48
RETENTION_DAYS=30
BLOCKED_NUMBERS=
WEBSITE_URLS=
